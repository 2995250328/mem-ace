flowchart LR
  %% Mem-ACE method figure structural draft for draw.io recreation.
  %% Use as a logic check, not as the final visual asset.

  subgraph PanelA["(a) Mem-ACE framework"]
    subgraph Offline["Offline memory construction"]
      TrainData["Posed training images<br/>SfM/STGS geometry"]
      Preprocess["Offline Memory Construction<br/>feature pooling + track sidecars"]
      Memory["Pooled Scene Memory<br/>{p_i, f_i}, center c"]
      TrainData --> Preprocess --> Memory
    end

    Compressor["Geo-token Compressor"]
    Tokens["Anchored Scene Tokens<br/>(Z, P), K=64"]
    Memory --> Compressor --> Tokens

    subgraph Query["Query coordinate regression"]
      QueryImage["Query Image"]
      Encoder["SCR Backbone / Encoder"]
      QueryFeat["Dense Query Features Q"]
      Fusion["Memory Fusion<br/>(default Z + PE(P-c))"]
      Head["SCR Coordinate Head"]
      Coords["Dense Scene Coordinates"]
      Pose["PnP/RANSAC<br/>Pose Solver"]
      QueryImage --> Encoder --> QueryFeat --> Fusion --> Head --> Coords --> Pose
      Tokens -->|Z + PE(P-c)| Fusion
    end

    subgraph Supervision["Geometric training supervision"]
      Align["Geometric Alignment<br/>single-view reprojection"]
      CrossView["Cross-view Track Reprojection<br/>source-target SfM/STGS tracks"]
      Adapt["Cached Memory Adaptation<br/>cache tokens, adapt fusion/head"]
      Align --> Adapt
      CrossView --> Adapt
    end

    Coords -.-> Align
    Coords -.-> CrossView
  end

  subgraph PanelB["(b) Scene-anchored memory module"]
    Points["Memory Points X"]
    Features["Memory Features F"]
    Module["Geo-token Compressor"]
    Z["latent features Z"]
    P["latent positions P"]
    Center["scene center c"]
    PE["Centered Encoding<br/>PE(P-c)"]
    Q["Query Features Q"]
    FuseSmall["Memory Fusion<br/>(Z + PE(P-c))"]
    Fused["Fused Query Features"]
    HeadSmall["Coordinate Head"]

    Points --> Module
    Features --> Module
    Module --> Z
    Module --> P
    P --> PE
    Center --> PE
    Q --> FuseSmall
    Z --> FuseSmall
    PE --> FuseSmall
    FuseSmall --> Fused --> HeadSmall
  end

  classDef query fill:#e8f1ff,stroke:#2f5f9f,color:#172033;
  classDef memory fill:#eaf7ee,stroke:#2f7d4f,color:#172033;
  classDef output fill:#fff1df,stroke:#b46b1b,color:#172033;
  classDef train fill:#f4f4f4,stroke:#777,color:#172033;

  class QueryImage,Encoder,QueryFeat,Q query;
  class TrainData,Preprocess,Memory,Compressor,Tokens,Points,Features,Module,Z,P,Center,PE memory;
  class Fusion,Head,Coords,Pose,FuseSmall,Fused,HeadSmall output;
  class Align,CrossView,Adapt train;
