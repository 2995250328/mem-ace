ninja_required_version = 1.3
cxx = c++

cflags = -pthread -B /home/xwh/miniforge3/envs/mapanything/compiler_compat -fno-strict-overflow -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /home/xwh/miniforge3/envs/mapanything/include -fPIC -O2 -isystem /home/xwh/miniforge3/envs/mapanything/include -fPIC -I/data/xwh/miniforge3/envs/mapanything/include/opencv4 -I/data/xwh/miniforge3/envs/mapanything/lib/python3.12/site-packages/torch/include -I/data/xwh/miniforge3/envs/mapanything/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/data/xwh/miniforge3/envs/mapanything/lib/python3.12/site-packages/torch/include/TH -I/data/xwh/miniforge3/envs/mapanything/lib/python3.12/site-packages/torch/include/THC -I/home/xwh/miniforge3/envs/mapanything/include/python3.12 -c
post_cflags = -fopenmp -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=dsacstar -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc





build /home/xwh/project/ace_depth/dsacstar/build/temp.linux-x86_64-cpython-312/dsacstar.o: compile /home/xwh/project/ace_depth/dsacstar/dsacstar.cpp
build /home/xwh/project/ace_depth/dsacstar/build/temp.linux-x86_64-cpython-312/thread_rand.o: compile /home/xwh/project/ace_depth/dsacstar/thread_rand.cpp






